{
  "name": "@tally/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch --import ./src/dev-resolve.ts src/index.ts",
    "test": "node --test test/*.test.ts",
    "test:db": "docker compose -f docker-compose.test.yml up -d --wait && DATABASE_URL=postgresql://tally:tally@127.0.0.1:55433/tally_test npm test",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "pretypecheck": "npm run build -w @tally/shared",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tally/shared": "*",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "firebase-admin": "^14.2.0",
    "luxon": "^3.5.0",
    "pg": "^8.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
