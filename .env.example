# Tally — environment reference.
#
# Copy to .env for local work:   cp .env.example .env
# .env is gitignored. This file carries NAMES AND SHAPES ONLY — never paste a
# real key, password or connection string into it.
#
# Nothing loads .env implicitly — there is no dotenv in the dependency tree, so
# a stray .env cannot silently change how the server behaves. Ask Node for it:
#
#   node --env-file=.env server/dist/index.js
#
# The VITE_* block is the exception: Vite reads its own env files, from the web/
# directory, so those four go in web/.env.local for local frontend work.
#
# There are two kinds of variable here and the difference is the single most
# common way this deploy goes wrong:
#
#   RUNTIME    read by the server when the container starts. Change it, restart,
#              done.
#   BUILD-TIME the VITE_* block at the bottom. Vite inlines those values into
#              the JavaScript bundle when the image is built. Setting them as
#              runtime environment does nothing at all — the bundle was already
#              written. In Coolify they must be BUILD VARIABLES.
#
# Full walkthrough: docs/DEPLOY.md


# ─── Server, runtime ────────────────────────────────────────────────────────

# REQUIRED. The server refuses to start without it rather than failing at the
# first query. In production this is injected by Coolify from the managed
# Postgres; locally it points at whatever database you started.
# Shape: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://tally:tally@127.0.0.1:5432/tally

# Public origin of the deployed app, used to build invite links
# (<APP_ORIGIN>/j/<token>). No trailing slash — one is stripped if you leave it.
# Get this wrong and invites are generated pointing at the wrong host, which
# nothing else will warn you about.
# Default: http://localhost:5173
APP_ORIGIN=http://localhost:5173

# Port the API listens on. Coolify's proxy routes to this; the image sets 8080.
# Default: 8080
PORT=8080

# Absolute path to the built PWA. The image sets /app/web/dist. Empty disables
# static serving, which is what you want in development because Vite serves the
# frontend instead.
#
# It must be ABSOLUTE. A relative path half-works — assets are served, but every
# page navigation returns 500 "path must be absolute or specify root to
# res.sendFile" — which is issue #36.
# Default: empty (API only)
WEB_ROOT=

# NOT a performance setting. `production` disables the development auth bypass
# in server/src/firebase.ts (see TALLY_DEV_AUTH below), so it is a security
# control. The image bakes NODE_ENV=production in and it must stay that way in
# every deployed container.
# Default: development
NODE_ENV=development

# How long a new invite link stays valid, in days. 0 means links never expire.
# Default: 7
INVITE_DEFAULT_DAYS=7

# The Postgres channel instances fan live updates over, so a tick on one
# instance reaches a browser connected to another. Validated at boot: LISTEN
# takes an identifier rather than a bound parameter, so this is the one setting
# that ends up concatenated into SQL, and anything but a plain lower-case
# identifier stops the server starting.
#
# Channels are per-database, not per-schema. Two deployments sharing one
# database — or a test run alongside a dev server — need different names here
# or they hear each other's events.
# Default: tally_events
TALLY_EVENT_CHANNEL=tally_events


# ─── Security headers and logging (server, runtime) ─────────────────────────

# Send the Content-Security-Policy as Content-Security-Policy-Report-Only, so a
# policy that would break sign-in reports instead of breaking it. Meant for the
# first deploy of a policy change, not as a resting state.
#
# Read this before relying on it: no report-uri and no report-to are sent, so a
# violation is printed to the console of the browser that hit it and goes
# nowhere else. Nothing reaches this server and nothing reaches your logs. A
# quiet week of logs is therefore NO EVIDENCE AT ALL that the policy is clean —
# only that nobody was looking. Open devtools on a real sign-in, on each method,
# and read the console yourself.
#
# Leaving it on indefinitely is the worst of both worlds: unenforced and
# unobserved. Turn it on for a deploy, check by hand, turn it back off.
# Default: off
CSP_REPORT_ONLY=

# `json` or `text`, one structured line per request either way. Invite tokens,
# bearer tokens and Firebase apiKey/oobCode query parameters are redacted before
# anything is written.
# Default: json when NODE_ENV=production, text otherwise
LOG_FORMAT=


# ─── Rate limits (server, runtime) ──────────────────────────────────────────
#
# Request budgets, per minute. Both are validated at boot and must be ABOVE
# ZERO — a limit of 0 would lock everyone out of their own list, so the server
# refuses to start rather than answering everything with a 429 nobody can
# explain. Counters are in-memory, which assumes a single app instance, the
# same assumption /api/stream already makes.
#
# GET /api/health is never rate limited: a 429 there reads as a sick container
# and would take the app out of rotation.

# Unauthenticated invite-link lookups (`GET /api/invites/token/:token` and its
# accept), keyed on the client address — there is no account to key on yet.
# Opening a link costs two requests, so 20 is a household passing one link
# round several times and still not noticing.
# Default: 20
RATE_LIMIT_INVITE_LOOKUPS_PER_MINUTE=20

# Authenticated writes, keyed on the signed-in person rather than the address —
# a household is one address and four phones. Reads skip it entirely. Loose on
# purpose: a backstop against a runaway client, not a quota.
# Default: 240
RATE_LIMIT_WRITES_PER_MINUTE=240


# ─── Firebase Admin (server-side, SECRET) ───────────────────────────────────
#
# From the service account JSON: Firebase console → Project settings →
# Service accounts → Generate new private key. These verify ID tokens.
#
# THE PRIVATE KEY IS A REAL SECRET. It must never appear in web/, in a build
# arg, in a compose file, or in this repository. If all three are left empty the
# server falls back to Google Application Default Credentials
# (GOOGLE_APPLICATION_CREDENTIALS or workload identity).

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Multi-line PEM. Coolify and most dashboards store it with literal \n escapes;
# config.ts unescapes them, so either form works. Quote it in a .env file.
# Shape: "-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# The domain Firebase Auth serves its sign-in iframe from, which the CSP has to
# allow as a frame source or Google sign-in fails and nothing else does.
#
# NOT a secret, and not the same thing as VITE_FIREBASE_AUTH_DOMAIN below: Vite
# inlines that one into the bundle at build time and it never reaches the
# server. The default here is derived from FIREBASE_PROJECT_ID, so set this only
# if you use a custom auth domain — and if you do, it must match what the web
# build was given.
# Default: derived from FIREBASE_PROJECT_ID
FIREBASE_AUTH_DOMAIN=


# ─── Local development only ─────────────────────────────────────────────────

# Accepts `Authorization: Bearer dev:<uid>:<email>` instead of a real Firebase
# ID token, so the API can be exercised with curl and no Firebase project at
# all. Double-gated: it needs this opt-in AND a non-production NODE_ENV, and the
# deployed image is NODE_ENV=production, so it cannot switch itself on in a
# container. The server prints a loud warning whenever it is active.
#
# The browser UI has no dev-token path — signing in through the web app still
# needs real Firebase config. This is for the API.
#
# NEVER set this on a deployed environment.
TALLY_DEV_AUTH=

# Where the Vite dev server proxies /api. Read by web/vite.config.ts at dev
# time only; irrelevant in production, where one process serves both.
#
# Setting it HERE does not reach Vite. This file is only read by whatever you
# pass `--env-file=.env` to, and `npm run dev -w @tally/web` is not that.
# web/.env.local does not work either: vite.config.ts reads process.env, and
# Vite's own env files are exposed as import.meta.env to the app, never written
# back into process.env. Export it in the shell you start Vite from:
#
#   API_ORIGIN=http://localhost:9000 npm run dev -w @tally/web
#
# Default: http://localhost:8080
API_ORIGIN=http://localhost:8080


# ─── Web, BUILD-TIME (VITE_*) ───────────────────────────────────────────────
#
# Firebase console → Project settings → General → Your apps → Web app config.
#
# These are PUBLIC by design: they ship inside the JavaScript bundle and
# identify the project, they do not authorise anything. Access is controlled by
# Firebase auth rules and by this API. Do not confuse them with the service
# account key above, which is secret.
#
# Vite inlines them at BUILD time. In Coolify set them as BUILD VARIABLES, not
# just runtime environment. Set them only as runtime env and the frontend ships
# with undefined config: sign-in fails for everyone, with no server-side error
# to point at. The Dockerfile declares them as ARGs and prints a warning when a
# build has none.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
