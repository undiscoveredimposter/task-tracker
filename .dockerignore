# Keep the build context small and, more importantly, keep host state out of it.
# A stray local node_modules or dist would shadow what the image builds itself.

# Dependencies and build output — rebuilt inside the image
**/node_modules
**/dist
web/dev-dist
**/*.tsbuildinfo

# Version control and CI
.git
.gitignore
.github

# Local environment — never let a real .env reach a layer
.env
.env.*
**/*.pem
**/*service-account*.json

# Docs, agent config and editor state: none of it is needed to build or run
docs
README.md
.claude
.vscode
.idea

# Docker's own files
Dockerfile
.dockerignore
docker-compose*.yml

# Logs and OS noise
**/*.log
npm-debug.log*
.DS_Store
coverage
